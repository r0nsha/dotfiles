#!/usr/bin/env fish
# Changes the wallpaper to the given image and updates the updates the desktop according to the wallpaper's colors.

set img (readlink -f "$argv[1]")
if not test -f "$img"
    echo "Error: '$argv[1]' is not a valid file" >&2
    exit 1
end

awww img \
    --resize crop "$img" \
    --transition-type fade \
    --transition-duration 1 \
    --transition-fps 30

# link to cache so that others can reference it
ln -sf "$img" ~/.cache/current_background

ron-theme-generate
