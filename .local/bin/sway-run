#!/bin/sh

# general
export TERMINAL=ghostty
export TERMCMD=ghostty
export VISUAL=nvim
export EDITOR=nvim
export BROWSER=qutebrowser
export MANPAGER="nvim +Man!"

# electron
export ELECTRON_OZONE_PLATFORM_HINT=auto

# qt
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_QPA_PLATFORM=wayland

# force firefox into wayland
export MOZ_ENABLE_WAYLAND=1

# sway
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

# nvidia
if command -v nvidia-smi >/dev/null 2>&1 && [ "$(nvidia-smi -L 2>/dev/null | wc -l)" -gt 0 ]; then
    export GBM_BACKEND=nvidia-drm
    export LIBVA_DRIVER_NAME=nvidia
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export MOZ_DISABLE_RDD_SANDBOX=1
    export MOZ_WAYLAND_USE_VAAPI=1
    export NVD_BACKEND=direct
    export __GL_GSYNC_ALLOWED=1
    export __GL_VRR_ALLOWED=1
    export SWAY_UNSUPPORTED_GPU=true
    exec dbus-run-session sway --unsupported-gpu -Dnoscanout "$@"
else
    exec dbus-run-session sway "$@"
fi
