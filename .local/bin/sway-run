#!/usr/bin/env fish

# general
set -gx TERMINAL ghostty
set -gx TERMCMD ghostty
set -gx VISUAL nvim
set -gx EDITOR nvim
set -gx BROWSER qutebrowser
set -gx MANPAGER "nvim +Man!"

# electron
set -gx ELECTRON_OZONE_PLATFORM_HINT auto

# qt
set -gx QT_QPA_PLATFORMTHEME qt6ct
set -gx QT_QPA_PLATFORM wayland

# force firefox into wayland
set -gx MOZ_ENABLE_WAYLAND 1

# sway
set -gx XDG_CURRENT_DESKTOP sway
set -gx XDG_SESSION_DESKTOP sway
set -gx XDG_SESSION_TYPE wayland

# nvidia
set is_nvidia (command -q nvidia-smi && nvidia-smi -L 2>/dev/null | wc -l)
if test $is_nvidia -gt 0
    set -gx GBM_BACKEND nvidia-drm
    set -gx LIBVA_DRIVER_NAME nvidia
    set -gx __GLX_VENDOR_LIBRARY_NAME nvidia
    set -gx MOZ_DISABLE_RDD_SANDBOX 1
    set -gx MOZ_WAYLAND_USE_VAAPI 1
    set -gx NVD_BACKEND direct
    set -gx __GL_GSYNC_ALLOWED 1
    set -gx __GL_VRR_ALLOWED 1
    set -gx SWAY_UNSUPPORTED_GPU true
end

exec dbus-run-session sway
