#!/usr/bin/env fish

set selected (
    printf  "  files (fuzzy)\n  files (explorer)\n󰅌  clipboard" \
    | fuzzel --dmenu --minimal-lines --prompt "share> " \
    | string split '  ' --fields 2
)

switch $selected
    case "files (fuzzy)"
        footclient --app-id=ron.terminal.floating ron-share files
    case "files (explorer)"
        footclient --app-id=ron.terminal.floating ron-share --picker explorer files
    case clipboard
        ron-share clipboard
end
