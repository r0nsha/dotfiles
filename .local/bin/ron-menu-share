#!/usr/bin/env fish

set selected (
    printf  " files (fuzzy)\n files (explorer)\n󰅌 clipboard" \
    | fuzzel --dmenu --minimal-lines --prompt "share> " \
    | cut -d' ' -f2-
)

switch $selected
    case "files (fuzzy)"
        ghostty --class=ron.terminal.floating --command="ron-share files"
    case "files (explorer)"
        ghostty --class=ron.terminal.floating --command="ron-share --picker explorer files"
    case clipboard
        ron-share clipboard
end
