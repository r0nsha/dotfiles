{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "bash": {
      "rm*": "ask",
      "git push*": "ask",
      "git checkout*": "ask",
      "git commit*": "ask",
      "git reset*": "ask",
      "jj ci*": "ask",
      "jj commit*": "ask",
      "jj new*": "ask",
      "jj b*": "ask",
      "jj restore*": "ask",
      "jj abandon*": "ask",
      "yay*": "ask",
      "paru*": "ask",
    },
    "external_directory": {
      "~/dev/**": "allow",
    },
  },
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp"],
    },
  },
  "snapshot": false,
}
